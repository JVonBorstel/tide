{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tide.example/contracts/upgrade.schema.json",
  "title": "The upgrade switches: the `upgrade` block of kitchen/kitchen.json",
  "description": "One switch per new piece (build-way 4.1): old = today's path serves; shadow = the new piece runs beside it and writes only its own files plus a parity report; new = the new piece serves. Setting it back to old is the fallback; nothing is deleted. A missing block or switch reads as old. Moving a switch on the live PC is one card for Jordan. Keys starting with _ are notes for people.",
  "type": "object",
  "properties": {
    "ledger": { "$ref": "#/$defs/switch" },
    "engine": {
      "type": "object",
      "properties": { "adopted": { "$ref": "#/$defs/switch" }, "improve": { "$ref": "#/$defs/switch" } },
      "patternProperties": { "^_": { "type": "string" } },
      "required": ["adopted", "improve"],
      "additionalProperties": false
    },
    "crews": { "$ref": "#/$defs/switch" },
    "ship": {
      "type": "object",
      "properties": { "gates": { "$ref": "#/$defs/switch" }, "queue": { "$ref": "#/$defs/switch" } },
      "patternProperties": { "^_": { "type": "string" } },
      "required": ["gates", "queue"],
      "additionalProperties": false
    },
    "board": {
      "type": "object",
      "properties": { "work": { "$ref": "#/$defs/switch" } },
      "patternProperties": { "^_": { "type": "string" } },
      "required": ["work"],
      "additionalProperties": false
    },
    "continuity": {
      "type": "object",
      "properties": { "boot": { "$ref": "#/$defs/switch" } },
      "patternProperties": { "^_": { "type": "string" } },
      "required": ["boot"],
      "additionalProperties": false
    }
  },
  "patternProperties": { "^_": { "type": "string" } },
  "required": ["ledger", "engine", "crews", "ship", "board", "continuity"],
  "additionalProperties": false,
  "$defs": {
    "switch": { "enum": ["old", "shadow", "new"] }
  }
}
